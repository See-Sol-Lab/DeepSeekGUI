{
  "name": "@deepseek-ai/dsh-workbench-memory",
  "version": "0.1.7-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/See-Sol-Lab/DeepSeekGUI.git",
    "directory": "packages/api/workbench-memory"
  },
  "description": "DeepSeekGUI's engineering memory entries: versioned facts, preferences and continuation notes per project folder or global, with correction, forgetting, undo, reviewed import of the legacy Markdown memory files, and the memory tools, guide and per-step recall sessions use in entries mode",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./continuation": {
      "types": "./lib/types/continuation.d.ts",
      "default": "./lib/types/continuation.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "assets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
